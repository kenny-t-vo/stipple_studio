# macOS / exFAT noise
._*
.DS_Store
.Spotlight-V100
.Trashes

# python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# build output
build/
dist/
*.spec

# large working assets (kept on disk, not in git)
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.svg
*.svgz

# JSON is never ignored above, so no negation is needed here -- an earlier
# "!presets/*.json" re-included the exFAT ._ sidecars, which match it too.
